{
  "name": "ghd-autoscore",
  "productName": "国护积分管理",
  "version": "1.0.1",
  "description": "国旗护卫队单机版积分管理与统计工具",
  "main": "electron/main.js",
  "private": true,
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on tcp:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .\"",
    "dev:renderer": "vite",
    "build": "vite build",
    "start": "npm run build && electron .",
    "dist": "npm run build && electron-builder",
    "test:services": "node tests/services.test.cjs",
    "test:project": "node tests/project.test.cjs",
    "test": "npm run test:services && npm run test:project && npm run test:render",
    "test:render": "node tests/render.test.cjs"
  },
  "dependencies": {
    "call-bind-apply-helpers": "^1.0.2",
    "dunder-proto": "^1.0.1",
    "exceljs": "^4.4.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "postcss": "^8.4.49",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^3.4.17",
    "vite": "^5.4.11",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "com.ghd.autoscore",
    "productName": "国护积分管理",
    "files": [
      "dist/index.html",
      "dist/assets/**/*",
      "electron/**/*"
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "国护积分管理"
    },
    "mac": {
      "target": "dmg"
    }
  }
}
